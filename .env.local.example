# GoldSeason Website Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE DATABASE (Required for production)
# ============================================
# 1. Go to https://supabase.com and create a project
# 2. Go to Settings > Database
# 3. Copy the Connection string (URI)
# 4. Paste it below replacing [YOUR-PASSWORD] and [YOUR-PROJECT-REF]

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================
# NEXTAUTH.JS (Required for authentication)
# ============================================
# Generate a secret: openssl rand -base64 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=[GENERATE-WITH-OPENSSL-RAND-BASE64-32]

# ============================================
# STRIPE PAYMENT (When implementing payments)
# ============================================
# Get from https://dashboard.stripe.com/apikeys

STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...