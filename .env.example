# GoldSeason Website Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Stripe Payment API Keys (when implementing payments)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase Database (when implementing database)
# Get these from your Supabase project settings: Settings > Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Database (if using a database)
# DATABASE_URL=postgresql://...

# Amazon Affiliate (optional)
# AMAZON_ASSOCIATE_TAG=your-tag

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX